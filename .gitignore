# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
release-build
*.local

# Invoice data (personal/financial - keep local only).
# Anchored to the repo root: the old unanchored `data/` also ignored
# src/data/ (demo data + starter catalogue), which broke clean builds.
/data/

# Master product catalogue (~38 MB) is regenerated deterministically by
# scripts/ensure-catalogs.mjs before every build.
public/data/catalogs/
Saved Invoices/
Trash/

# AI assistant context
.claude/

# v1.10.33 — Tesseract assets are regenerated by
# scripts/bundle-tesseract-assets.mjs on every install/build. Keeping
# them out of the repo avoids a ~22MB blob and lets tesseract version
# bumps in package.json flow through cleanly.
public/tesseract/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Session scratch from other agent tooling — not part of the project
.zcode

# Built documentation site (regenerate with: node docs-site/build.mjs)
docs-site/out/

# Secrets - never commit. .env.example (placeholders only) IS tracked.
.env
.env.*
!.env.example
.dev.vars
