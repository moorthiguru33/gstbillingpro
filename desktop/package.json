{
  "name": "gst-billing-pro-desktop",
  "productName": "GST Billing Pro",
  "version": "1.0.0",
  "description": "GST Billing Pro for Windows - desktop wrapper for https://gst-billing-pro.pages.dev",
  "author": "D Printers",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "dev.pages.gstbillingpro.desktop",
    "productName": "GST Billing Pro",
    "copyright": "© D Printers",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "icon.png", "package.json"],
    "afterPack": "./build/afterPack.js",
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GST Billing Pro",
      "artifactName": "GST-Billing-Pro-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GST-Billing-Pro-Portable-${version}.exe"
    }
  }
}
