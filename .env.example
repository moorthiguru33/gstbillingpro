# ============================================================
# GST Billing Pro — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!
# ============================================================

# ---- Supabase ----
# Get from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# ---- Razorpay ----
# Get from: https://dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID

# ---- App Branding ----
VITE_APP_NAME=GST Billing Pro
VITE_APP_URL=https://your-site.pages.dev

# ============================================================
# The following are SECRETS — set in Cloudflare Pages Dashboard
# Settings → Environment Variables (NOT in this file for security)
# ============================================================
# RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY
