# ============================================================
# GST Billing Pro — Environment Variables (PLACEHOLDERS ONLY)
# Copy to .env for local development. NEVER commit .env.
# ============================================================

# ---- Browser (public, baked into the JS bundle at build time) ----
# Supabase → Project Settings → API. The anon key is public by design;
# security comes from Row Level Security (see supabase/migrations/).
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Razorpay → Settings → API Keys. KEY ID only (public). Never the secret.
VITE_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID

VITE_APP_NAME=GST Billing Pro
VITE_APP_URL=https://gst-billing-pro.pages.dev

# ============================================================
# SERVER SECRETS — set ONLY in Cloudflare Pages → Settings →
# Variables and Secrets (type: Secret). For local `wrangler pages dev`
# put them in .dev.vars (git-ignored). Never prefix these with VITE_.
# ============================================================
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Comma-separated list of origins allowed to call /api/* from a browser.
# ALLOWED_ORIGINS=https://gst-billing-pro.pages.dev,https://gstbillingpro.com
